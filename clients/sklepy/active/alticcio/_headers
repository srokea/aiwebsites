# Nagłówki Cloudflare Pages dla plików statycznych (nie dotyczą functions/api/*).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Panel obsługi: poza wyszukiwarkami, bez osadzania w ramkach, bez cache.
# (X-Frame-Options z reguły /* łączyłby się z drugim nagłówkiem w „SAMEORIGIN, DENY” —
#  dlatego zakaz ramek dla panelu idzie przez CSP, które przeglądarki stawiają wyżej.)
/panel
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: frame-ancestors 'none'
  Cache-Control: no-store

/panel/*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: frame-ancestors 'none'
  Cache-Control: no-store
