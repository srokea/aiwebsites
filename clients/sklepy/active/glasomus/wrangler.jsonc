// Hosting: Cloudflare Workers (statyczne pliki). Wdrożenie z tego folderu: npx wrangler deploy
// Pliki, które nie mają być publiczne, są wykluczone w .assetsignore.
{
  "name": "glasomus",
  "compatibility_date": "2026-11-06",
  "routes": [
    { "pattern": "aquatabsglasomus.pl", "custom_domain": true },
    { "pattern": "www.aquatabsglasomus.pl", "custom_domain": true }
  ],
  "assets": {
    "directory": "."
  }
}
