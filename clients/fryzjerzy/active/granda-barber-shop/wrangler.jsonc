// Hosting: Cloudflare Workers (statyczne pliki). Wdrożenie z tego folderu: npx wrangler deploy
// Pliki, które nie mają być publiczne, są wykluczone w .assetsignore.
// Nazwa Workera z panelu Cloudflare - nie zmieniaj, bo powstanie nowy Worker.
{
  "name": "granda",
  "compatibility_date": "2026-11-12",
  "routes": [
    // www.grandabarbershop.pl ma w Cloudflare własny, ręcznie dodany rekord DNS - Worker nie może go przejąć,
    // dopóki ktoś nie usunie tego rekordu w panelu (DNS -> Records).
    { "pattern": "grandabarbershop.pl", "custom_domain": true }
  ],
  "assets": {
    "directory": "."
  }
}
