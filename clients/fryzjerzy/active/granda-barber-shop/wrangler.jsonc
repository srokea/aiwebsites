// Hosting: Cloudflare Workers (statyczne pliki). Wdrożenie z tego folderu: npx wrangler deploy
// Pliki, które nie mają być publiczne, są wykluczone w .assetsignore.
// UWAGA: ta strona była dotąd wdrażana poza tym plikiem i wystawiała publicznie brief.md.
// Przed wdrożeniem wpisz w "name" DOKŁADNĄ nazwę istniejącego Workera z panelu Cloudflare
// (Workers & Pages -> worker podpięty pod grandabarbershop.pl). Inna nazwa utworzyłaby drugiego Workera.
{
  "name": "WPISZ_NAZWE_WORKERA_Z_PANELU",
  "compatibility_date": "2026-11-12",
  "routes": [
    { "pattern": "grandabarbershop.pl", "custom_domain": true },
    { "pattern": "www.grandabarbershop.pl", "custom_domain": true }
  ],
  "assets": {
    "directory": "."
  }
}
