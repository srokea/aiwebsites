# Skopiuj do .env i uzupelnij. .env nigdy nie trafia do gita.

# Katalog na bufory, wycinki, klipy i baze (duzo miejsca)
CLIPPER_DATA_DIR=D:\gta-clipper-data

# Ollama (lokalny LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Whisper
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16

# ntfy: losowy, trudny do zgadniecia temat (kazdy, kto go zna, widzi powiadomienia)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# Twitch Helix (klipy widzow) - z dev.twitch.tv
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube: sciezka do pliku OAuth z Google Cloud
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
